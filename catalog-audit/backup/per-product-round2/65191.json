{"id": 65191, "name": "הנדפרסו חשמלי לרכב -פודים - Handpresso", "slug": "%d7%94%d7%a0%d7%93%d7%a4%d7%a8%d7%a1%d7%95-%d7%97%d7%a9%d7%9e%d7%9c%d7%99-%d7%9c%d7%a8%d7%9b%d7%91-%d7%a4%d7%95%d7%93%d7%99%d7%9d-handpresso", "permalink": "https://www.minuto.co.il/product/%d7%94%d7%a0%d7%93%d7%a4%d7%a8%d7%a1%d7%95-%d7%97%d7%a9%d7%9e%d7%9c%d7%99-%d7%9c%d7%a8%d7%9b%d7%91-%d7%a4%d7%95%d7%93%d7%99%d7%9d-handpresso/", "date_created": "2025-03-24T18:24:40", "date_created_gmt": "2025-03-24T15:24:40", "date_modified": "2025-11-16T18:14:29", "date_modified_gmt": "2025-11-16T15:14:29", "type": "simple", "status": "publish", "featured": false, "catalog_visibility": "visible", "description": "<p><!-- wp:heading {\"level\":1} --></p>\n<h1 class=\"wp-block-heading\">הנדפרסו חשמלי לרכב -פודים - Handpresso</h1>\n<p><!-- /wp:heading --></p>\n<p><!-- wp:paragraph --></p>\n<p>מכונת אספרסו חשמלית לרכב הנדפרסו תתאים באופן מושלם לרכב.</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>המכונה מתחברת לשקע 12/24 וולט והיא יכולה להכנס למחזיק הכוסות באוטו.</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>אמין, אינטואיטיבי, זריז עם מגע דיגיטלי מדויק, המכונה מכינה אספרסו מושלם! בתוך 2 דקות וחצי.</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>קפה: אספרסו קצר (50 מ\"ל)</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>לחץ: 19 בר</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>אספקת חשמל: (12 / 24v) תקע מצת סיגריות</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>זמן הכנה: 2:30</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>• ניטור דיגיטלי של מחזור ההכנה</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>• זרבובית מיוחדת למניעת התזה</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>הערה לכל אוהבי הקפה הגדולה: להביא Handpresso אוטומטי איתך  ולהתפנק גם בדרכים באספרסו מושלם !</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>יבואן תמר בחן בע״מ</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>אחריות: 12 חודשים</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:heading {\"level\":3} --></p>\n<h3 class=\"wp-block-heading\"><a href=\"https://www.minuto.co.il/blog/%d7%9e%d7%9b%d7%95%d7%a0%d7%aa-%d7%a7%d7%a4%d7%94-%d7%9c%d7%a9%d7%98%d7%97-%d7%a9%d7%9e%d7%a2%d7%aa%d7%9d-%d7%a2%d7%9c-%d7%94%d7%98%d7%a8%d7%a0%d7%93-%d7%94%d7%97%d7%93%d7%a9/\">מאמר על מכונת אספרסו לשטח</a></h3>\n<p><!-- /wp:heading --></p>\n", "short_description": "<ul>\n<li>מכונת אספרסו חשמלית לרכב</li>\n<li>\n<div>מכונת אספרסו לשטח מבוססת פודים Handpresso Auto <strong><span id=\"result_box\" lang=\"iw\">לחץ 19 בר</span></strong></div>\n</li>\n<li> </li>\n<li><strong><strong><span lang=\"iw\">נוסעים לטיול, הדרך ארוכה, אין בית קפה באזור, לא נורא יש לכם את המכונה המדהימה והחדישה של הנדפרסו.</span></strong></strong>מכניסים פוד מוסיפים מים מכניסים לשקע המצת ותוך פחות מ-3 דקות יש אספרסו איכותי.</li>\n</ul>\n", "sku": "800400-1-3", "price": "740.0000", "regular_price": "740.0000", "sale_price": "", "date_on_sale_from": null, "date_on_sale_from_gmt": null, "date_on_sale_to": null, "date_on_sale_to_gmt": null, "on_sale": false, "purchasable": true, "total_sales": 0, "virtual": false, "downloadable": false, "downloads": [], "download_limit": -1, "download_expiry": -1, "external_url": "", "button_text": "", "tax_status": "taxable", "tax_class": "", "manage_stock": true, "stock_quantity": 0, "backorders": "no", "backorders_allowed": false, "backordered": false, "low_stock_amount": null, "sold_individually": false, "weight": "", "dimensions": {"length": "", "width": "", "height": ""}, "shipping_required": true, "shipping_taxable": true, "shipping_class": "", "shipping_class_id": 0, "reviews_allowed": false, "average_rating": "0.00", "rating_count": 0, "upsell_ids": [], "cross_sell_ids": [], "parent_id": 0, "purchase_note": "", "categories": [{"id": 394, "name": "מכונות קפה", "slug": "%d7%9e%d7%9b%d7%95%d7%a0%d7%95%