_on_the_brand"}, {"id": 839363, "key": "_pys_head_footer", "value": {"disable_global": false, "head_any": "", "head_desktop": "", "head_mobile": "", "footer_any": "", "footer_desktop": "", "footer_mobile": ""}}, {"id": 839364, "key": "rank_math_primary_product_brand", "value": "0"}, {"id": 839365, "key": "rank_math_primary_product_cat", "value": "0"}, {"id": 845052, "key": "rank_math_analytic_object_id", "value": "1010"}, {"id": 1618457, "key": "_wc_gla_synced_at", "value": "1749870020"}, {"id": 1618458, "key": "_wc_gla_sync_status", "value": "synced"}, {"id": 1618459, "key": "_wc_gla_visibility", "value": "sync-and-show"}, {"id": 1618460, "key": "_wc_gla_google_ids", "value": {"IL": "online:iw:IL:gla_64885"}}, {"id": 1670105, "key": "_pys_conversion_label_settings", "value": {"enable": false, "label": "", "id": "AW-993138580"}}, {"id": 1780183, "key": "_wc_gla_mc_status", "value": "approved"}, {"id": 1799400, "key": "block_editor", "value": "1"}, {"id": 1799401, "key": "_acf_changed", "value": ""}, {"id": 1995098, "key": "rank_math_internal_links_processed", "value": "1"}, {"id": 2108361, "key": "_minuto_faq_published", "value": "[{\"q\":\"מה מייחד את הלינאה מיני מבחינה טכנית?\",\"a\":\"הלינאה מיני מצוידת בדוד כפול עם בקרת PID, המאפשר יציבות טמפרטורה גבוהה בזמן החליטה. מערכת טרום-החליטה המשופרת, עם שני שסתומים, מרטיבה את עוגיית הקפה בעדינות לפני החליטה ומאפשרת מיצוי אחיד ומדויק. בנוסף, לחץ המשאבה מתכוונן בקלות, כך שאפשר להתאים את החליטה לפי הפולים ורמת הטחינה.\"},{\"q\":\"למי המכונה הזו מתאימה?\",\"a\":\"הלינאה מיני מתאימה למגוון רחב של משתמשים, החל מחובבי קפה סקרנים ועד בריסטות מנוסים שרוצים חוויה ביתית ברמה גבוהה. אלו שחולמים על שליטה אמיתית בחליטה, עם אפשרות לחלוט לפי משקל ולנטר בעזרת טיימר מובנה, ימצאו בה כלי שמתאים גם להעמקה לאורך זמן.\"},{\"q\":\"האם המכונה מתאימה להכנת לאטה ארט?\",\"a\":\"כן. דוד הקיטור הנפרד מאפשר הקצפת חלב ללא הפסקה בין החליטה לקיטור, שזה יתרון משמעותי לאלו שמתאמנים על לאטה ארט או שחשובה להם יציבות טמפרטורת הקיטור. נורות הבריסטה הייעודיות מוסיפות גם רמת דיוק בזמן העבודה.\"},{\"q\":\"מה זה ויסות לחץ משאבה ולמה זה חשוב?\",\"a\":\"ויסות לחץ המשאבה מאפשר להתאים את עוצמת המים שעוברים דרך עוגיית הקפה במהלך החליטה. ב-Linea Mini ההתאמה פשוטה ונגישה, ומאפשרת להתאים את האספרסו לכל פולים ולכל פרופיל קלייה. כך אפשר להפיק את המיטב מכל סוג קפה, במקום להיות מוגבלים ללחץ סטנדרטי אחד.\"},{\"q\":\"מה זו חליטה לפי משקל ואיך זה עובד בפועל?\",\"a\":\"חליטה לפי משקל, או Brew-by-Weight, היא שיטה שבה המכונה עוצרת את החליטה בהתאם למשקל הקפה הנוזלי שנאסף בכוס, ולא רק לפי זמן. כך מקבלים עקביות גבוהה יותר מנה למנה, במיוחד כשמשנים פולים או רמת טחינה. זוהי אחת התכונות שהופכות את הלינאה מיני לכלי מדויק גם עבור אלו שרוצים להעמיק ולשפר את האספרסו שלהם לאורך זמן.\"}]"}], "stock_status": "instock", "has_options": false, "post_password": "", "global_unique_id": "", "_links": {"self": [{"href": "https://www.minuto.co.il/wp-json/wc/v3/products/64885", "targetHints": {"allow": ["GET", "POST", "PUT", "PATCH", "DELETE"]}}], "collection": [{"href": "https://www.minuto.co.il/wp-json/wc/v3/products"}]}}