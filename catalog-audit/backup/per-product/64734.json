{"id": 64734, "name": "פולי קפה ספשלטי קפה מינוטו נטול קפאין - Minuto Decaffeinato", "slug": "%d7%a4%d7%95%d7%9c%d7%99-%d7%a7%d7%a4%d7%94-%d7%a1%d7%a4%d7%a9%d7%9c%d7%98%d7%99-%d7%a7%d7%a4%d7%94-%d7%9e%d7%99%d7%a0%d7%95%d7%98%d7%95-%d7%a0%d7%98%d7%95%d7%9c-%d7%a7%d7%a4%d7%90%d7%99%d7%9f-minut", "permalink": "https://www.minuto.co.il/product/%d7%a4%d7%95%d7%9c%d7%99-%d7%a7%d7%a4%d7%94-%d7%a1%d7%a4%d7%a9%d7%9c%d7%98%d7%99-%d7%a7%d7%a4%d7%94-%d7%9e%d7%99%d7%a0%d7%95%d7%98%d7%95-%d7%a0%d7%98%d7%95%d7%9c-%d7%a7%d7%a4%d7%90%d7%99%d7%9f-minut/", "date_created": "2025-03-24T18:23:13", "date_created_gmt": "2025-03-24T15:23:13", "date_modified": "2026-09-24T14:59:14", "date_modified_gmt": "2026-09-24T11:59:14", "type": "variable", "status": "publish", "featured": false, "catalog_visibility": "visible", "description": "<p><!-- wp:heading {\"level\":1} --></p>\n<h3 class=\"wp-block-heading\">פולי קפה מינוטו נטול קפאין - Decaffeinato</h3>\n<p><!-- /wp:heading --></p>\n<p><!-- wp:paragraph --></p>\n<p>תערובת נטולת קפאין המורכבת מ 100 % ערביקה מקסיקנית, שעברה דה קפאין בשיטת Water Process תהליך טבעי המבוסס על מים ופחם פעיל, בלי שימוש בכימיקלים.</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>שיטה זו שומרת על הארומה והטעמים המקוריים של הפולים, כך שתוכלו ליהנות מקפה עשיר גם בלי קפאין.</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>פולי ערביקה המקסיקניים ידועים בגוף בינוני ובטעם חלק ומאוזן עם רמזים לשוקולד, אגוזים ותבלינים, והם מעניקים לכוס מרקם קרמי ומתקתק. <br />בקלייה עדינה מתקבל קפה נטול קפאין עם גוף מלא, מתיקות טבעית ואיזון עדין של חמיצות.</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>מושלם למי שמחפש חוויית קפה מפנקת בשעות הערב או למי שמעדיף להפחית את צריכת הקפאין.</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>&nbsp;</p>\n<p><!-- /wp:paragraph --></p>\n", "short_description": "<p>330 גר פולי קפה נטול <b>100% ערביקה מקסיקנית, נטול בתהליך Water proccess </b> <strong>איך זה מרגיש?</strong></p>\n<p dir=\"rtl\">קפה עדין, עם גוף מלא, מתקתק וקרמי</p>\n", "sku": "99907880231", "price": "69.0000", "regular_price": "", "sale_price": "", "date_on_sale_from": null, "date_on_sale_from_gmt": null, "date_on_sale_to": null, "date_on_sale_to_gmt": null, "on_sale": false, "purchasable": true, "total_sales": 223, "virtual": false, "downloadable": false, "downloads": [], "download_limit": -1, "download_expiry": -1, "external_url": "", "button_text": "", "tax_status": "taxable", "tax_class": "", "manage_stock": false, "stock_quantity": null, "backorders": "no", "backorders_allowed": false, "backordered": false, "low_stock_amount": null, "sold_individually": false, "weight": "0", "dimensions": {"length": "", "width": "", "height": ""}, "shipping_required": true, "shipping_taxable": true, "shipping_class": "", "shipping_class_id": 0, "reviews_allowed": false, "average_rating": "0.00", "rating_count": 0, "upsell_ids": [], "cross_sell_ids": [], "parent_id": 0, "purchase_note": "", "categories": [{"id": 419, "name": "המלצות מומחי הקפה שלנו", "slug": "%d7%94%d7%9e%d7%9c%d7%a6%d7%95%d7%aa-%d7%9e%d7%95%d7%9e%d7%97%d7%99-%d7%94%d7%a7%d7%a4%d7%94-%d7%a9%d7%9c%d7%a0%d7%95"}, {"id": 379, "name": "פולי קפה", "slug": "%d7%a4%d7%95%d7%9c%d7%99-%d7%a7%d7%a4%d7%94"}, {"id": 413, "name": "פולי קפה חד זני", "slug": "%d7%a4%d7%95%d7%9c%d7%99-%d7%a7%d7%a4%d7%94-%d7%97%d7%93-%d7%96%d7%a0%d7%99"}, {"id": 380, "name": "פולי קפה טרי - קפה ספשלטי specialty coffee", "slug": "%d7%a4%d7%95%d7%9c%d7%99-%d7%a7%d7%a4%d7%94-%d7%98%d7%a8%d7%99-%d7%9e%d7%99%d7%a0%d7%95%d7%98%d7%95-specialty-coffee"}], "brands": [], "tags": [], "images": [{"id": 79290, "date_created": "2025-12-31T23:51:01", "date_created_gmt": "2025-12-31T17:51:01", "date_modified": "2025-12-31T23:51:01", "date_modified_gmt": "2025-12-31T17:51:01", "src": "https://www.minuto.co.il/content/uploads/2025/03/DECAFF.png", "name": "DECAFF", "alt": "פולי קפה ספשלטי קפה מינוטו נטול קפאין &#8211; Minuto Decaffeinato", "srcset": "https://www.minuto.co.i