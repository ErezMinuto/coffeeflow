{"id": 68284, "name": "מתאם קפסולות NS לקפסולות נספרסו או תואמות למכונת ננופרסו", "slug": "%d7%9e%d7%aa%d7%90%d7%9d-%d7%a7%d7%a4%d7%a1%d7%95%d7%9c%d7%95%d7%aa-ns-%d7%9c%d7%a7%d7%a4%d7%a1%d7%95%d7%9c%d7%95%d7%aa-%d7%a0%d7%a1%d7%a4%d7%a8%d7%a1%d7%95-%d7%90%d7%95-%d7%aa%d7%95%d7%90%d7%9e%d7%95", "permalink": "https://www.minuto.co.il/product/%d7%9e%d7%aa%d7%90%d7%9d-%d7%a7%d7%a4%d7%a1%d7%95%d7%9c%d7%95%d7%aa-ns-%d7%9c%d7%a7%d7%a4%d7%a1%d7%95%d7%9c%d7%95%d7%aa-%d7%a0%d7%a1%d7%a4%d7%a8%d7%a1%d7%95-%d7%90%d7%95-%d7%aa%d7%95%d7%90%d7%9e%d7%95/", "date_created": "2025-03-25T10:22:48", "date_created_gmt": "2025-03-25T07:22:48", "date_modified": "2025-07-24T16:14:23", "date_modified_gmt": "2025-07-24T13:14:23", "type": "simple", "status": "publish", "featured": false, "catalog_visibility": "visible", "description": "<p><!-- wp:heading {\"level\":3} --></p>\n<h3 class=\"wp-block-heading\">מתאם קפסולות NS לקפסולות נספרסו או תואמות למכונת ננופרסו</h3>\n<p><!-- /wp:heading --></p>\n<p><!-- wp:paragraph --></p>\n<p><span lang=\"iw\" xml:lang=\"iw\">מתאם הקפסולות של ננופרסו מאפשר להשתמש בקפסולות NS* עם מכשיר הננופרסו שלכם.</span></p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p><span lang=\"iw\" xml:lang=\"iw\">היתרון הגדול של השימוש בקפסולות הוא, שהקפה נטחן מראש בעובי הנדרש במדויק, בכמות המדודה, המותאם בדייקנות גבוהה למכשיר.</span></p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p><span lang=\"iw\" xml:lang=\"iw\">מרווח הטעות הוא קטן ביותר. בצורה כזו&nbsp;האספרסו שלכם הוא עקבי בכל שימוש.&nbsp;שימוש בקפסולות&nbsp;הוא נוח ונקי.</span></p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>*קפסולות NS מתיחס לקפסולות נספרסו® מקוריות ותואמות.</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>**נספרסו® היא חברה שלישית ללא קשר כלשהו לחברת Wacaco Company Limited</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>יבואן אמיגו פ״ת</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>אחריות 12 חודשים</p>\n<p><!-- /wp:paragraph --></p>\n", "short_description": "<p><span id=\"result_box\" lang=\"iw\">מתאם הקפסולות של ננופרסו מאפשר להשתמש בקפסולות NS* עם מכשיר הננופרסו שלכם.</span></p>\n", "sku": "800403", "price": "75.0000", "regular_price": "75.0000", "sale_price": "", "date_on_sale_from": null, "date_on_sale_from_gmt": null, "date_on_sale_to": null, "date_on_sale_to_gmt": null, "on_sale": false, "purchasable": true, "total_sales": 0, "virtual": false, "downloadable": false, "downloads": [], "download_limit": -1, "download_expiry": -1, "external_url": "", "button_text": "", "tax_status": "taxable", "tax_class": "", "manage_stock": false, "stock_quantity": null, "backorders": "no", "backorders_allowed": false, "backordered": false, "low_stock_amount": null, "sold_individually": false, "weight": "", "dimensions": {"length": "", "width": "", "height": ""}, "shipping_required": true, "shipping_taxable": true, "shipping_class": "", "shipping_class_id": 0, "reviews_allowed": false, "average_rating": "0.00", "rating_count": 0, "upsell_ids": [], "cross_sell_ids": [], "parent_id": 0, "purchase_note": "", "categories": [{"id": 485, "name": "מכונות קפה לשטח", "slug": "%d7%9e%d7%9b%d7%95%d7%a0%d7%95%d7%aa-%d7%a7%d7%a4%d7%94-%d7%9c%d7%a9%d7%98%d7%97"}, {"id": 478, "name": "מכונות קפה ניידות Wacaco", "slug": "%d7%9e%d7%9b%d7%95%d7%a0%d7%95%d7%aa-%d7%a7%d7%a4%d7%94-%d7%a0%d7%99%d7%99%d7%93%d7%95%d7%aa-wacaco"}], "brands": [], "tags": [], "images": [{"id": 68495, "date_created": "2025-03-25T10:23:53", "date_created_gmt": "2025-03-25T07:23:53", "date_modified": "2025-03-25T10:50:31", "date_modified_gmt": "2025-03-25T07:50:31", "src": "https://www.minuto.co.il/content/uploads/2025/03/1711549847_Wacaco-NS_adaptor-2.png", "name": "1711549847_Wacaco-NS_adaptor-2.png", "alt": "מתאם קפסולות NS לקפסולות נספרסו או תואמות למכונת ננופרסו", "srcset": "https://www.minuto.co.il/content/uploads/2025/03/1711549847_Wacaco-NS_adaptor-2.png 510w, https://www.minuto.co.il/content/uploa