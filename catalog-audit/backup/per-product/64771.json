"options": ["1000"]}], "default_attributes": [], "variations": [], "grouped_products": [], "menu_order": 0, "price_html": "<span class=\"woocommerce-Price-amount amount\"><bdi><span class=\"woocommerce-Price-currencySymbol\" translate=\"no\">&#8362;</span>131</bdi></span>", "related_ids": [78450, 65169, 64885, 65179, 65180], "meta_data": [{"id": 845169, "key": "rank_math_analytic_object_id", "value": "1127"}, {"id": 1618110, "key": "_wc_gla_synced_at", "value": "1749697236"}, {"id": 1618111, "key": "_wc_gla_sync_status", "value": "synced"}, {"id": 1618112, "key": "_wc_gla_visibility", "value": "sync-and-show"}, {"id": 1618113, "key": "_wc_gla_google_ids", "value": {"IL": "online:iw:IL:gla_64771"}}, {"id": 1780098, "key": "_wc_gla_mc_status", "value": "approved"}, {"id": 1800433, "key": "rank_math_seo_score", "value": "9"}, {"id": 1800451, "key": "block_editor", "value": "1"}, {"id": 1800508, "key": "_pys_conversion_label_settings", "value": {"enable": false, "label": "", "id": "AW-993138580"}}, {"id": 1800513, "key": "blend", "value": ""}, {"id": 1800514, "key": "_blend", "value": "field_product_blend"}, {"id": 1800515, "key": "type_of_coffee", "value": ""}, {"id": 1800516, "key": "_type_of_coffee", "value": "field_product_type_of_coffee"}, {"id": 1800517, "key": "country_flag", "value": ""}, {"id": 1800518, "key": "_country_flag", "value": "field_product_country_flag"}, {"id": 1800519, "key": "country", "value": ""}, {"id": 1800520, "key": "_country", "value": "field_product_country"}, {"id": 1800521, "key": "more_information", "value": ""}, {"id": 1800522, "key": "_more_information", "value": "field_product_more_information"}, {"id": 1800523, "key": "on_the_brand", "value": ""}, {"id": 1800524, "key": "_on_the_brand", "value": "field_product_on_the_brand"}, {"id": 1800525, "key": "_pys_head_footer", "value": {"disable_global": false, "head_any": "", "head_desktop": "", "head_mobile": "", "footer_any": "", "footer_desktop": "", "footer_mobile": ""}}, {"id": 1816822, "key": "rank_math_primary_product_cat", "value": "419"}, {"id": 1816823, "key": "_acf_changed", "value": ""}, {"id": 1883657, "key": "rank_math_description", "value": "פולי קפה ספשלטי בקלייה טרייה מבית מינוטו. איכות פרימיום לאספרסו או פילטר מושלם - מבצע מיוחד. קלייה טרייה לאיכות מקסימלית"}, {"id": 2090019, "key": "rank_math_internal_links_processed", "value": "1"}, {"id": 2108347, "key": "_minuto_faq_published", "value": "[{\"q\":\"מה טעמו של הקפה הזה?\",\"a\":\"וונטו פרימיום מציע פרופיל עוצמתי עם תווים חזקים של קקאו, רמזים של פירות יבשים וטונים של לחם קלוי. התערובת משלבת חומציות מאוזנת עם גוף עשיר שמעניק חווית טעם קומפלקסית וגוונונית.\"},{\"q\":\"מאיפה מגיע הקפה הזה?\",\"a\":\"התערובת משלבת ערביקה משובחת מאמריקה המרכזית והדרומית עם רובוסטה הודית איכותית. הקפוד על בחירת גרגרים מאזורים מובילים מבטיח פרופיל טעמים עשיר ומאוזן.\"},{\"q\":\"מה ההרכב של התערובת?\",\"a\":\"וונטו פרימיום מורכב מ-40% קפה ערביקה ארומטי ו-60% קפה רובוסטה. הקומבינציה הזו יוצרת תערובת אינטנסיבית עם גוף מלא וטעם עשיר שמתאימה לטעמים שונים.\"},{\"q\":\"איזה שיטת חליטה מתאימה הכי טוב?\",\"a\":\"התערובת הזו מעניקה תוצאות מעולות במכונות קפה אספרסו בזכות הגוף העשיר שלה, והיא אידיאלית גם לקפוצ'ינו וקפוצ'ינו. ניתן להתאים את טחינת הפולים לסוג המכונה שלך כדי להשיג חליטה מושלמת.\"},{\"q\":\"מה מיוחד בקלייה של הקפה הזה?\",\"a\":\"קלייה מדויקת של פולי הערביקה המשובחים יוצרת פרופיל טעמים מאוזן ועמוק שלא מדכא את הארומות הטבעיים. הקלייה נועדה להבליט את התווים של קקאו ופירות יבשים שמאפיינים את התערובת.\"}]"}], "stock_status": "instock", "has_options": false, "post_password": "", "global_unique_id": "", "_links": {"self": [{"href": "https://www.minuto.co.il/wp-json/wc/v3/products/64771", "targetHints": {"allow": ["GET", "POST", "PUT", "PATCH", "DELETE"]}}], "collection": [{"href": "https://www.minuto.co.il/wp-json/wc/v3/products"}]}}