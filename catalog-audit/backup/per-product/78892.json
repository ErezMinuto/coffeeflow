ה</strong></h3>\n<p data-start=\"552\" data-end=\"617\">ארוז בסביבה מוגנת לשמירה על טריות מרבית, טעמים נקיים וניחוח עשיר.</p>\n", "short_description": "<p>קפה נטול קפאין בעל טעם מלא ועדין, המופק מתהליך דה־קפאין ייחודי השומר על הארומה המקורית.<br />\nקפה עם טעמים מאוזנים, פודים קומפוסטבילים המתאימים לכל מכונות ESE 44.</p>\n<p>ארוז בסביבה מוגנת לשמירה על טריות מושלמת.</p>\n", "sku": "692442b587a02", "price": "89", "regular_price": "89", "sale_price": "", "date_on_sale_from": null, "date_on_sale_from_gmt": null, "date_on_sale_to": null, "date_on_sale_to_gmt": null, "on_sale": false, "purchasable": true, "total_sales": 2, "virtual": false, "downloadable": false, "downloads": [], "download_limit": -1, "download_expiry": -1, "external_url": "", "button_text": "", "tax_status": "taxable", "tax_class": "", "manage_stock": true, "stock_quantity": 0, "backorders": "no", "backorders_allowed": false, "backordered": false, "low_stock_amount": null, "sold_individually": false, "weight": "0", "dimensions": {"length": "", "width": "", "height": ""}, "shipping_required": true, "shipping_taxable": true, "shipping_class": "", "shipping_class_id": 0, "reviews_allowed": false, "average_rating": "0.00", "rating_count": 0, "upsell_ids": [], "cross_sell_ids": [], "parent_id": 0, "purchase_note": "", "categories": [{"id": 527, "name": "פודים", "slug": "%d7%a4%d7%95%d7%93%d7%99%d7%9d"}], "brands": [], "tags": [], "images": [{"id": 78893, "date_created": "2025-11-24T19:46:31", "date_created_gmt": "2025-11-24T13:46:31", "date_modified": "2025-11-24T19:46:44", "date_modified_gmt": "2025-11-24T13:46:44", "src": "https://www.minuto.co.il/content/uploads/2025/11/Mauro_tropea_pod.png", "name": "50 פודים קפה מאורו נטול קופאין Mauro Tropa Pods", "alt": "50 פודים קפה מאורו נטול קופאין Mauro Tropa Pods", "srcset": "https://www.minuto.co.il/content/uploads/2025/11/Mauro_tropea_pod.png 600w, https://www.minuto.co.il/content/uploads/2025/11/Mauro_tropea_pod-300x300.png 300w, https://www.minuto.co.il/conte