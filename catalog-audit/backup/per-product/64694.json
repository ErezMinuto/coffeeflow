{"id": 64694, "name": "קופסת אחסון קפה AIRSCAPE כ- 500 גרם קפה צבע אדום", "slug": "%d7%a7%d7%95%d7%a4%d7%a1%d7%aa-%d7%90%d7%97%d7%a1%d7%95%d7%9f-%d7%a7%d7%a4%d7%94-airscape-%d7%9b-500-%d7%92%d7%a8%d7%9d-%d7%a7%d7%a4%d7%94-%d7%a6%d7%91%d7%a2-%d7%90%d7%93%d7%95%d7%9d", "permalink": "https://www.minuto.co.il/product/%d7%a7%d7%95%d7%a4%d7%a1%d7%aa-%d7%90%d7%97%d7%a1%d7%95%d7%9f-%d7%a7%d7%a4%d7%94-airscape-%d7%9b-500-%d7%92%d7%a8%d7%9d-%d7%a7%d7%a4%d7%94-%d7%a6%d7%91%d7%a2-%d7%90%d7%93%d7%95%d7%9d/", "date_created": "2025-03-24T18:23:06", "date_created_gmt": "2025-03-24T15:23:06", "date_modified": "2026-08-18T13:42:06", "date_modified_gmt": "2026-08-18T10:42:06", "type": "simple", "status": "publish", "featured": false, "catalog_visibility": "visible", "description": "<p><!-- wp:heading --></p>\n<h2 class=\"wp-block-heading\">קופסת אחסון קפה AIRSCAPE כ- 500 גרם קפה צבע אדום</h2>\n<p><!-- /wp:heading --></p>\n<p><!-- wp:paragraph --></p>\n<p>מיכל אחסון קפה גורמה מקורי של איירסקייפ עם מכסה בוכנת פטנט מסיר ונועל אוויר ולחות. השסתום החד כיווני משחרר CO2 לשמירה והגנה על טריות וטעם</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>מכסה המסיר את כל האוויר במכל ויוצר חלל חסר אוויר; מאריך את חיי הקפה. צליל ה\"סוווש\" בסגירת המכסה מאפשר לך לדעת שהוא עובד.</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>מיכל אחסון קפה איירסקייפ עשוי פלדת אל חלד, רכיבים ללא BPA בגימור צבע חיצוני עמיד. מספר צבעים זמינים להוספת צבע למטבח שלך. שטיפת</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>מיכל גדול אייסקייפ מכיל כ- 500 גר פולי קפה.</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>במיכל רגיל, האוויר הכלוא יחד עם הקפה, מכיל גם חמצן ולחות הפוגעים בטריותו ואיכותו של הקפה</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>* הערה - אין לאחסן קפה טחון או כל חומר אבקתי בתפזורת. אם רוצים לאחסן קפה טחון או חומר אבקתי יש לאחסן אותו כשהו ארוז בתוך שקית.</p>\n<p><!-- /wp:paragraph --></p>\n", "short_description": "<ul>\n<li>מיכל לאחסון קפה  איירסקייפ &#8211; מכסה אטום אוויר מוגן בפטנט ושומר על טריות המזון עם שסתום CO2 חד כיווני, מיכל מזון נירוסטה</li>\n<li>מכיל כ-500 גר קפה</li>\n</ul>\n", "sku": "645771002558", "price": "215.0000", "regular_price": "215.0000", "sale_price": "", "date_on_sale_from": null, "date_on_sale_from_gmt": null, "date_on_sale_to": null, "date_on_sale_to_gmt": null, "on_sale": false, "purchasable": true, "total_sales": 1, "virtual": false, "downloadable": false, "downloads": [], "download_limit": -1, "download_expiry": -1, "external_url": "", "button_text": "", "tax_status": "taxable", "tax_class": "", "manage_stock": true, "stock_quantity": 0, "backorders": "no", "backorders_allowed": false, "backordered": false, "low_stock_amount": null, "sold_individually": false, "weight": "", "dimensions": {"length": "", "width": "", "height": ""}, "shipping_required": true, "shipping_taxable": true, "shipping_class": "", "shipping_class_id": 0, "reviews_allowed": false, "average_rating": "0.00", "rating_count": 0, "upsell_ids": [], "cross_sell_ids": [], "parent_id": 0, "purchase_note": "", "categories": [{"id": 415, "name": "Airscape - אירסקייפ", "slug": "airscape-%d7%90%d7%99%d7%a8%d7%a1%d7%a7%d7%99%d7%99%d7%a4"}, {"id": 374, "name": "מוצרים נלווים", "slug": "%d7%90%d7%91%d7%99%d7%96%d7%a8%d7%99-%d7%a7%d7%a4%d7%94"}, {"id": 414, "name": "קופסאות אחסון לקפה", "slug": "%d7%a7%d7%95%d7%a4%d7%a1%d7%90%d7%95%d7%aa-%d7%90%d7%97%d7%a1%d7%95%d7%9f-%d7%9c%d7%a7%d7%a4%d7%94"}], "brands": [], "tags": [], "images": [{"id": 65626, "date_created": "2025-03-24T18:26:25", "date_created_gmt": "2025-03-24T15:26:25", "date_modified": "2026-06-14T16:47:32", "date_modified_gmt": "2026-06-14T10:47:32", "src": "https://www.minuto.co.il/content/uploads/2025/03/1711548351_Airscape_500_gr_Red-1.png", "name": "1711548351_Airscape_500_gr_Red-1.png", "alt": "קופסת אחסון קפה AIRSCAPE כ- 500 גרם קפה צבע אדום", "srcset": "https://www.minuto.co.il/content/uploads/2025/03/1711548351_Airscape