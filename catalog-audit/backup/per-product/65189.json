ync_status", "value": "synced"}, {"id": 1648304, "key": "_wc_gla_synced_at", "value": "1749495447"}, {"id": 1648305, "key": "_wc_gla_google_ids", "value": {"IL": "online:iw:IL:gla_69694"}}, {"id": 1781032, "key": "_wc_gla_mc_status", "value": "partially_approved"}, {"id": 1796587, "key": "block_editor", "value": "1"}, {"id": 1796588, "key": "_acf_changed", "value": ""}, {"id": 1796605, "key": "_pys_conversion_label_settings", "value": {"enable": false, "label": "", "id": "AW-993138580"}}, {"id": 1796620, "key": "_pys_head_footer", "value": {"disable_global": false, "head_any": "", "head_desktop": "", "head_mobile": "", "footer_any": "", "footer_desktop": "", "footer_mobile": ""}}, {"id": 1883899, "key": "rank_math_description", "value": "פולי קפה מינוטו טריאסט ספשלטי בקלייה טרייה מבית מינוטו. איכות פרימיום לאספרסו או פילטר מושלם - טרי. קלייה טרייה לאיכות מקסימלית"}, {"id": 1911870, "key": "rank_math_focus_keyword", "value": "מינוטו טריאסט"}, {"id": 1911872, "key": "rank_math_primary_product_brand", "value": "0"}, {"id": 1911873, "key": "rank_math_primary_product_cat", "value": "0"}, {"id": 1994848, "key": "rank_math_internal_links_processed", "value": "1"}, {"id": 2003116, "key": "rank_math_title", "value": "פולי קפה מינוטו טריאסט - תערובת ספשלטי טרייה | %sitename%"}, {"id": 2108369, "key": "_minuto_faq_published", "value": "[{\"q\":\"מה טעמו של קפה זה?\",\"a\":\"תערובת זו מציעה גוף מלא עם עשירות קרמית, טעם עז ואינטנסיבי עם רמיזות של שוקולד מריר. הקומבינציה של 80% ערביקה ו-20% רובוסטה יוצרת אל-תערובת מוצקה ומאתגרת.\"},{\"q\":\"מאיפה הפולים שלכם?\",\"a\":\"התערובת מורכבת מפולים מדרום אמריקה והודו, שמגדלים בגבהים שונים. השילוב של אזורים אלה תורם לאופי העמוק והעשיר של הקפה.\"},{\"q\":\"מה ההבדל בין ערביקה לרובוסטה בתערובת זו?\",\"a\":\"התערובת מכילה 80% ערביקה שמעניקה כיווניים מעודנים יותר, ו-20% רובוסטה שיוצרת גוף חזק וקרמה עשירה. הרובוסטה מחזקת את האופי העז ויוצרת בסיס יציב למשקאות אספרסו.\"},{\"q\":\"איך הכי טוב להכין את הקפה הזה?\",\"a\":\"קפה זה עוצב במיוחד לאספרסו, קפוצ'ינו ומשקאות חלב אחרים. אפשר גם להכינו בפילטר או בקפה שחור, תלוי בהעדפה אישית. ניתן להתאים את רמת הטחינה לשיטת ההכנה שלך.\"},{\"q\":\"למה בחרתם בתערובת מדרום אמריקה והודו?\",\"a\":\"שילוב זה מאפשר גוף מלא ויציב עם עומק טעם משמעותי, מה שהופך אותו לאידיאלי לעיצוב משקאות קלאסיים. פולים מאזורים אלה מספקים קרמה טבעית וטעמי שוקולד מריר שחברים בתערובת היטב.\"}]"}], "stock_status": "instock", "has_options": true, "post_password": "", "global_unique_id": "", "_links": {"self": [{"href": "https://www.minuto.co.il/wp-json/wc/v3/products/65189", "targetHints": {"allow": ["GET", "POST", "PUT", "PATCH", "DELETE"]}}], "collection": [{"href": "https://www.minuto.co.il/wp-json/wc/v3/products"}]}}