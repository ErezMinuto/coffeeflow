{"id": 64702, "name": "פולי קפה טרי ספשלטי קפה מינוטו אריסטו  - Minuto Specialty Coffee", "slug": "%d7%a4%d7%95%d7%9c%d7%99-%d7%a7%d7%a4%d7%94-%d7%98%d7%a8%d7%99-%d7%a1%d7%a4%d7%a9%d7%9c%d7%98%d7%99-%d7%a7%d7%a4%d7%94-%d7%9e%d7%99%d7%a0%d7%95%d7%98%d7%95-%d7%90%d7%a8%d7%99%d7%a1%d7%98%d7%95-minu", "permalink": "https://www.minuto.co.il/product/%d7%a4%d7%95%d7%9c%d7%99-%d7%a7%d7%a4%d7%94-%d7%98%d7%a8%d7%99-%d7%a1%d7%a4%d7%a9%d7%9c%d7%98%d7%99-%d7%a7%d7%a4%d7%94-%d7%9e%d7%99%d7%a0%d7%95%d7%98%d7%95-%d7%90%d7%a8%d7%99%d7%a1%d7%98%d7%95-minu/", "date_created": "2025-03-24T18:23:07", "date_created_gmt": "2025-03-24T15:23:07", "date_modified": "2026-09-24T14:59:08", "date_modified_gmt": "2026-09-24T11:59:08", "type": "variable", "status": "publish", "featured": false, "catalog_visibility": "visible", "description": "<p><!-- wp:heading {\"level\":1} --></p>\n<h3 class=\"wp-block-heading\"><strong>פולי קפה מינוטו אריסטו- Espresso Aristo</strong></h3>\n<p><!-- /wp:heading --></p>\n<p><!-- wp:paragraph --></p>\n<p>תערובת הקפה \"אריסטו\" נולדה אחרי חודשים של טעימות, ניסויים ועדכונים קטנים שבדיוק מהם מורכבת שלמות.</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>רצינו ליצור תערובת ספשלטי שתהיה יציבה, עשירה, ומדויקת - כזו שאפשר לסמוך עליה בכל שוט.</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>היא מבוססת על שילוב מוקפד של פולים ממקורות שונים, בגובה רב, אשר מעניקים לה גוף חלק, קרמה עבה וטעמים קלאסיים של שוקולד מריר, אגוזים קלויים ומרירות עדינה שמחזיקה גם בחלב וגם באספרסו קצר.</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>מתאימה למי שמחפש קפה חזק, הרמוני ולא מתפשר, לשימוש יומיומי במכונות אספרסו, קפסולות פתוחות או מקינטה.</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>מקור: <em>ברזיל</em></p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>תערובת מתאימה במיוחד למשקאות האספרסו ,קפוצ'ינו והכנת קפה במקינטה</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>&nbsp;</p>\n<p><!-- /wp:paragraph --></p>\n", "short_description": "<ul>\n<li>תערובת 100% ערביקה, מושלמת לאספרסו ולאוהבי הקפו׳צינו החזק, תערובת עם גוונים של שוקולד ואגוזים, תערובת חלקה וקרמית.מקור: <em>ברזיל</em></li>\n<li>פולי קפה פרימיום טרי וקלוי במקום</li>\n<li>100% ערביקה</li>\n</ul>\n<p>330 גר</p>\n", "sku": "0100000007", "price": "59.0000", "regular_price": "", "sale_price": "", "date_on_sale_from": null, "date_on_sale_from_gmt": null, "date_on_sale_to": null, "date_on_sale_to_gmt": null, "on_sale": false, "purchasable": true, "total_sales": 2148, "virtual": false, "downloadable": false, "downloads": [], "download_limit": -1, "download_expiry": -1, "external_url": "", "button_text": "", "tax_status": "taxable", "tax_class": "", "manage_stock": false, "stock_quantity": null, "backorders": "no", "backorders_allowed": false, "backordered": false, "low_stock_amount": null, "sold_individually": false, "weight": "0.33", "dimensions": {"length": "", "width": "", "height": ""}, "shipping_required": true, "shipping_taxable": true, "shipping_class": "", "shipping_class_id": 0, "reviews_allowed": false, "average_rating": "0.00", "rating_count": 0, "upsell_ids": [], "cross_sell_ids": [], "parent_id": 0, "purchase_note": "", "categories": [{"id": 419, "name": "המלצות מומחי הקפה שלנו", "slug": "%d7%94%d7%9e%d7%9c%d7%a6%d7%95%d7%aa-%d7%9e%d7%95%d7%9e%d7%97%d7%99-%d7%94%d7%a7%d7%a4%d7%94-%d7%a9%d7%9c%d7%a0%d7%95"}, {"id": 379, "name": "פולי קפה", "slug": "%d7%a4%d7%95%d7%9c%d7%99-%d7%a7%d7%a4%d7%94"}, {"id": 380, "name": "פולי קפה טרי - קפה ספשלטי specialty coffee", "slug": "%d7%a4%d7%95%d7%9c%d7%99-%d7%a7%d7%a4%d7%94-%d7%98%d7%a8%d7%99-%d7%9e%d7%99%d7%a0%d7%95%d7%98%d7%95-specialty-coffee"}, {"id": 381, "name": "תערובות קפה מינוטו", "slug": "%d7%aa%d7%a2%d7%a8%d7%95%d7%91%d7%95%d7%aa-%d7%a7%d7%a4%d7%94"}], "brands": [], "tags": [], "images": [{"id": 79291, "date_created": "2025-12-31T23:52:18", "date_created_gmt": "2025-12-31T17:52:18", "date_modified": "2026-09-18T00:19:54", "date