al_limits", "value": "off"}, {"id": 1976861, "key": "woosb_total_limits_min", "value": ""}, {"id": 1976862, "key": "woosb_total_limits_max", "value": ""}, {"id": 1976863, "key": "woosb_exclude_unpurchasable", "value": "unset"}, {"id": 1976864, "key": "woosb_layout", "value": "unset"}, {"id": 1976865, "key": "woosb_custom_price", "value": ""}, {"id": 1976866, "key": "woosb_before_text", "value": ""}, {"id": 1976867, "key": "woosb_after_text", "value": ""}, {"id": 1976868, "key": "rank_math_internal_links_processed", "value": "1"}, {"id": 2003077, "key": "rank_math_title", "value": "ערכת התנסות פולי קפה ספשלטי - טעימות מינוטו | %sitename%"}, {"id": 2066713, "key": "_minuto_rank_math_description_backup_final_v1", "value": {"existed": true, "value": "פולי קפה ספשלטי בקלייה טרייה מבית מינוטו. איכות פרימיום לאספרסו או פילטר מושלם - ערכת. קלייה טרייה לאיכות מקסימלית", "created_at": "2026-07-23 12:12:20", "version": "7.0.0"}}, {"id": 2108376, "key": "_minuto_faq_published", "value": "[{\"q\":\"מה טעמו של הקפה בערכת ההתנסות?\",\"a\":\"בערכת ההתנסות ארבע תערובות שונות, כל אחת בפרופיל טעם ייחודי. אריסטו מציע טעם שוקולדי עשיר וקרמי, Trieste מאוזן עם רמז שוקולד מריר, אינטנסו חזק עם ניחוח שוקולד ופירות, ופרסטיג' עדין עם גוונים שוקולדיים ואגוזיים. זה מאפשר לגלות איזה פרופיל מתאים ביותר לטעמך.\"},{\"q\":\"מאיפה מגיעים הפולים?\",\"a\":\"התערובות בערכה כוללות פולי ערביקה וקאפי רויאל רובוסטה מאזורים שונים. אריסטו מוצא מברזיל, Trieste משלבת דרום אמריקה ורובוסטה משובח, אינטנסו משולבת אפריקה ודרום אמריקה עם רובוסטה פרימיום, ופרסטיג' מברזיל ורובוסטה.\"},{\"q\":\"מה השיטה שבה קלויים הפולים?\",\"a\":\"כל התערובות בערכה קלויות בקלייה בינונית, שמאזנת בין טעם עמוק לחמציות נעימה. הקלייה הזו מתאימה לשיטות חליטה שונות, מאספרסו ועד פילטר.\"},{\"q\":\"איך מומלץ להחליט את הקפה?\",\"a\":\"אפשר להחליט את הפולים בכל שיטה שמעדיפים – אספרסו, קפה שחור, מקינטה, פילטר, פרנץ פרס או קולד ברו. מומלץ לשנות את השיטה בכל תערובת כדי להבין איזו שיטה מביאה לידי ביטוי את הפרופיל שלה בצורה הטובה ביותר.\"},{\"q\":\"למה בחרתם דווקא בתערובות ולא בפולים טהורים?\",\"a\":\"התערובות עוצבו כדי ליצור איזון וטעמים מורכבים שלא אפשר לקבל מזן יחיד. כל תערובת משלבת ערביקה לעדינות עם רובוסטה לגוף, מה שמביא ניסיון קפה שלם ומעניין לכל כוס.\"}]"}], "stock_status": "instock", "has_options": false, "post_password": "", "global_unique_id": "", "_links": {"self": [{"href": "https://www.minuto.co.il/wp-json/wc/v3/products/67217", "targetHints": {"allow": ["GET", "POST", "PUT", "PATCH", "DELETE"]}}], "collection": [{"href": "https://www.minuto.co.il/wp-json/wc/v3/products"}]}}