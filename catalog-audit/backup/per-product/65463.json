מיצות עדינה וטעמים פירותיים, וגם למי שרוצה לגוון את שגרת הקפה שלו בבחירה מקצועית וטרייה.\"}]"}], "stock_status": "instock", "has_options": true, "post_password": "", "global_unique_id": "", "_links": {"self": [{"href": "https://www.minuto.co.il/wp-json/wc/v3/products/65463", "targetHints": {"allow": ["GET", "POST", "PUT", "PATCH", "DELETE"]}}], "collection": [{"href": "https://www.minuto.co.il/wp-json/wc/v3/products"}]}}