{"id": 64821, "name": "10 ק״ג אבקת אייס קפה דיאט למכונות גרניטה", "slug": "10-%d7%a7%d7%b4%d7%92-%d7%90%d7%91%d7%a7%d7%aa-%d7%90%d7%99%d7%99%d7%a1-%d7%a7%d7%a4%d7%94-%d7%93%d7%99%d7%90%d7%98-%d7%9c%d7%9e%d7%9b%d7%95%d7%a0%d7%95%d7%aa-%d7%92%d7%a8%d7%a0%d7%99%d7%98%d7%94", "permalink": "https://www.minuto.co.il/product/10-%d7%a7%d7%b4%d7%92-%d7%90%d7%91%d7%a7%d7%aa-%d7%90%d7%99%d7%99%d7%a1-%d7%a7%d7%a4%d7%94-%d7%93%d7%99%d7%90%d7%98-%d7%9c%d7%9e%d7%9b%d7%95%d7%a0%d7%95%d7%aa-%d7%92%d7%a8%d7%a0%d7%99%d7%98%d7%94/", "date_created": "2025-03-24T18:23:28", "date_created_gmt": "2025-03-24T15:23:28", "date_modified": "2026-10-07T12:06:57", "date_modified_gmt": "2026-10-07T09:06:57", "type": "simple", "status": "publish", "featured": false, "catalog_visibility": "visible", "description": "<p><!-- wp:heading {\"level\":3} --></p>\n<h3 class=\"wp-block-heading\">אבקת אייס קפה דיאט&nbsp;למכונות גרניטה</h3>\n<p><!-- /wp:heading --></p>\n<p><!-- wp:paragraph --></p>\n<p>אבקת האייס של בלובריז מעניקה לך את החופש והיכולת ליצור משקה הגרניטה המושלם, ללקוחות שלך!</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>מתכון להכנת אייס קפה דיאט בבית</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>אייס קפה דיאט להכנה ביתית לכוס 330מ\"ל</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:list --></p>\n<ul class=\"wp-block-list\"><!-- wp:list-item --></p>\n<li>למלא את הכוס בקוביות קרח עד הסוף ולשפוך לבלנדר.</li>\n<p><!-- /wp:list-item --></p>\n<p><!-- wp:list-item --></p>\n<li>למלא את הכוס (כ 1/3 שליש) בחלב ושוב לשפןך לבלנדר.</li>\n<p><!-- /wp:list-item --></p>\n<p><!-- wp:list-item --></p>\n<li>להוסיף לבלנדר 2 כפות גדושות שלאבקת אייס קפה , להפעיל את הבלנדר לפחות לדקה עד קבלת המירקם הרצוי.</li>\n<p><!-- /wp:list-item --></ul>\n<p><!-- /wp:list --></p>\n<p><!-- wp:paragraph --></p>\n<p>האבקה פותחה במיוחד עבור הכנה עם מכונות בטמפרטורות שונות. הנוסחה הייחודית מאפשרת שימוש בטמפרטורה נמוכה, מושלם להפקת קפוצ'ינו הקר ללא המסת הקרח!</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>אנו מספקים את כל מה שאתה צריך לעשות שייק גרניטה טעים.</p>\n<p><!-- /wp:paragraph --></p>\n", "short_description": "<p>אבקת אייס דיאט למכונות</p>\n<p>כל שקית מכילה 600 גר</p>\n", "sku": "14051011212331123", "price": "650.0000", "regular_price": "650.0000", "sale_price": "", "date_on_sale_from": null, "date_on_sale_from_gmt": null, "date_on_sale_to": null, "date_on_sale_to_gmt": null, "on_sale": false, "purchasable": true, "total_sales": 2, "virtual": false, "downloadable": false, "downloads": [], "download_limit": -1, "download_expiry": -1, "external_url": "", "button_text": "", "tax_status": "taxable", "tax_class": "", "manage_stock": true, "stock_quantity": 0, "backorders": "no", "backorders_allowed": false, "backordered": false, "low_stock_amount": null, "sold_individually": false, "weight": "", "dimensions": {"length": "", "width": "", "height": ""}, "shipping_required": true, "shipping_taxable": true, "shipping_class": "", "shipping_class_id": 0, "reviews_allowed": false, "average_rating": "0.00", "rating_count": 0, "upsell_ids": [], "cross_sell_ids": [], "parent_id": 0, "purchase_note": "", "categories": [{"id": 454, "name": "אבקות לאייס קפה", "slug": "%d7%90%d7%91%d7%a7%d7%95%d7%aa-%d7%9c%d7%90%d7%99%d7%99%d7%a1-%d7%a7%d7%a4%d7%94"}], "brands": [], "tags": [], "images": [{"id": 65892, "date_created": "2025-03-24T18:28:48", "date_created_gmt": "2025-03-24T15:28:48", "date_modified": "2025-07-23T15:04:23", "date_modified_gmt": "2025-07-23T09:04:23", "src": "https://www.minuto.co.il/content/uploads/2025/03/1711548661_7e336928-b671-11ed-9ad8-d6c71093ad63-2-1.png", "name": "1711548661_7e336928-b671-11ed-9ad8-d6c71093ad63-2-1.png", "alt": "10 ק״ג אבקת אייס קפה דיאט למכונות גרניטה", "srcset": "https://www.minuto.co.il/content/uploads/2025/03/1711548661_7e336928-b671-11ed-9ad8-d6c71093ad63-2-1.png 637w, https://www.minuto.co.il/content/uploads/2025/03/1711548661_7e336928-b671-11ed-9ad8-d6c71093ad63-2-1-255x300.png 255w, https://www.mi