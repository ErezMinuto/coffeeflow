{"id": 64904, "name": "ספל קפה קורטאדו נוט-ניוטרל notNeutral Vero Cortado Glass עשן", "slug": "%d7%a1%d7%a4%d7%9c-%d7%a7%d7%a4%d7%94-%d7%a7%d7%95%d7%a8%d7%98%d7%90%d7%93%d7%95-%d7%a0%d7%95%d7%98-%d7%a0%d7%99%d7%95%d7%98%d7%a8%d7%9c-notneutral-vero-cortado-glass-%d7%a2%d7%a9%d7%9f", "permalink": "https://www.minuto.co.il/product/%d7%a1%d7%a4%d7%9c-%d7%a7%d7%a4%d7%94-%d7%a7%d7%95%d7%a8%d7%98%d7%90%d7%93%d7%95-%d7%a0%d7%95%d7%98-%d7%a0%d7%99%d7%95%d7%98%d7%a8%d7%9c-notneutral-vero-cortado-glass-%d7%a2%d7%a9%d7%9f/", "date_created": "2025-03-24T18:23:43", "date_created_gmt": "2025-03-24T15:23:43", "date_modified": "2026-10-02T11:55:29", "date_modified_gmt": "2026-10-02T08:55:29", "type": "simple", "status": "publish", "featured": false, "catalog_visibility": "visible", "description": "<p><!-- wp:heading {\"level\":1,\"className\":\"ProductMeta__Title Heading u-h2\"} --></p>\n<h1 class=\"wp-block-heading ProductMeta__Title Heading u-h2\">ספל קפה קורטאדו נוט-ניוטרל notNeutral Vero Cortado Glass</h1>\n<p><!-- /wp:heading --></p>\n<p><!-- wp:paragraph --></p>\n<p>notNeutral המותג האמריקאי מלוס אנג'לס, שכובש את עולם הקפה ב-20 השנים האחרונות.</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>ספלי הזכוכית מסדרת Vero מבית notNeutral – ללא ספק ספל הזכוכית המבוקש ביותר בקרב מקצועני הקפה בעולם.</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>ספל קורטאדו בנפח 125 מ\"ל – הספל הראשון בסדרת הזכוכית Vero צורות וחיתוכים גיאומטריים ושימוש בצבעים ייחודיים – הופכים את סדרת Vero לשילוב האופטימאלי בין הקלאסי למודרני.</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:list --></p>\n<ul class=\"wp-block-list\"><!-- wp:list-item --></p>\n<li>עיצוב פנימי מעוגל, מושלם עבור התפתחות הטעמים בקפה ושמירה על הקרמה</li>\n<p><!-- /wp:list-item --></p>\n<p><!-- wp:list-item --></p>\n<li>זכוכית האיכותית, עבה במיוחד ובעלת משקל. לאחיזה מושלמת.</li>\n<p><!-- /wp:list-item --></p>\n<p><!-- wp:list-item --></p>\n<li>מתאים למדיח כלים ולמקירוגל. מיוצר בסטנדרט של מסעדות ובתי קפה</li>\n<p><!-- /wp:list-item --></p>\n<p><!-- wp:list-item --></p>\n<li>מעוצב ומיוצר בארה\"ב – עשוי עבודת יד ולכן ייתכנו הבדלים טבעיים בגווני הצבע.</li>\n<p><!-- /wp:list-item --></p>\n<p><!-- wp:list-item --></p>\n<li>גובה 76.2 מ\"מ, רוחב 76.2 מ\"מ</li>\n<p><!-- /wp:list-item --></ul>\n<p><!-- /wp:list --></p>\n", "short_description": "<p>notNeutral המותג האמריקאי מלוס אנג'לס, שכובש את עולם הקפה ב-20 השנים האחרונות.</p>\n<p>ספלי הזכוכית מסדרת Vero מבית notNeutral – ללא ספק ספל הזכוכית המבוקש ביותר בקרב מקצועני הקפה בעולם.</p>\n<p>125 מ״ל</p>\n", "sku": "12451505544", "price": "74", "regular_price": "74", "sale_price": "", "date_on_sale_from": null, "date_on_sale_from_gmt": null, "date_on_sale_to": null, "date_on_sale_to_gmt": null, "on_sale": false, "purchasable": true, "total_sales": 4, "virtual": false, "downloadable": false, "downloads": [], "download_limit": -1, "download_expiry": -1, "external_url": "", "button_text": "", "tax_status": "taxable", "tax_class": "", "manage_stock": true, "stock_quantity": 5, "backorders": "no", "backorders_allowed": false, "backordered": false, "low_stock_amount": null, "sold_individually": false, "weight": "", "dimensions": {"length": "", "width": "", "height": ""}, "shipping_required": true, "shipping_taxable": true, "shipping_class": "", "shipping_class_id": 0, "reviews_allowed": false, "average_rating": "0.00", "rating_count": 0, "upsell_ids": [], "cross_sell_ids": [], "parent_id": 0, "purchase_note": "", "categories": [{"id": 483, "name": "notNeutral", "slug": "notneutral"}, {"id": 374, "name": "מוצרים נלווים", "slug": "%d7%90%d7%91%d7%99%d7%96%d7%a8%d7%99-%d7%a7%d7%a4%d7%94"}, {"id": 780, "name": "סדרת Vero", "slug": "%d7%a1%d7%93%d7%a8%d7%aa-vero"}, {"id": 438, "name": "ספלים וכוסות קפה", "slug": "%d7%a1%d7%a4%d7%9c%d7%99%d7%9d-%d7%95%d7%9b%d7%95%d7%a1%d7%95%d7%aa-%d7%a7%d7%a4%d7%94"}], "brands": [], "tags": [], "images": [{"id": 66064, "date_created": "2025-03-24T18:30:31", "date_created_gmt": "2025-03-24T15:30:31", "date