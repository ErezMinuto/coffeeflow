bile": "", "footer_any": "", "footer_desktop": "", "footer_mobile": ""}}, {"id": 1816825, "key": "rank_math_primary_product_cat", "value": "419"}, {"id": 1816826, "key": "_acf_changed", "value": ""}, {"id": 1883658, "key": "rank_math_description", "value": "פולי קפה ספשלטי בקלייה טרייה מבית מינוטו. איכות פרימיום לאספרסו או פילטר מושלם - מומלץ בחום. קלייה טרייה לאיכות מקסימלית"}, {"id": 2090020, "key": "rank_math_internal_links_processed", "value": "1"}, {"id": 2108348, "key": "_minuto_faq_published", "value": "[{\"q\":\"מה טעמו של Veneto Delux?\",\"a\":\"תערובת זו מציעה טעמים עשירים ומאוזנים עם מתיקות עדינה ותווים אגוזיים. החומציות נמוכה וההרגשה חלקה וקטיפתית, מה שיוצר חוויה קולינרית מעוגלת.\"},{\"q\":\"איך מורכבת התערובת?\",\"a\":\"Veneto Delux מורכבת מ-60% ערביקה ארומטית ו-40% רובוסטה איכותית. שילוב זה יוצר איזון בין העדינות של הערביקה לעומק של הרובוסטה.\"},{\"q\":\"איך מקלים את הפולים?\",\"a\":\"הפולים עוברים קלייה מקומית טרייה בסגנון איטלקי, תוך שימוש בטכניקות איטליות מסורתיות. תהליך זה אטי ומדויק, המשמר את הטעמים העשירים של התערובת.\"},{\"q\":\"איזו שיטת חליטה מתאימה ביותר?\",\"a\":\"ניתן להכין את Veneto Delux בכל שיטה - אספרסו, פילטר קר או מכונת פילטר. הפרופיל המאוזן של התערובת מתאים לרוב השיטות ומשדר את הטעמים באופן מלא בכל אחת מהן.\"},{\"q\":\"למה לבחור בתערובת זו?\",\"a\":\"Veneto Delux היא בחירה מומלצת למי שמחפש קפה איטלקי אותנטי בעל איכות גבוהה. הקלייה המקומית והבחירה הקפדנית של הפולים מבטיחים חוויה עקבית וביתית בכל פעם.\"}]"}], "stock_status": "instock", "has_options": false, "post_password": "", "global_unique_id": "", "_links": {"self": [{"href": "https://www.minuto.co.il/wp-json/wc/v3/products/64772", "targetHints": {"allow": ["GET", "POST", "PUT", "PATCH", "DELETE"]}}], "collection": [{"href": "https://www.minuto.co.il/wp-json/wc/v3/products"}]}}