{"id": 68275, "name": "60 טבליות חזקות 2.5 גרם לניקוי מכונת קפה - Puly Cafe", "slug": "60-%d7%98%d7%91%d7%9c%d7%99%d7%95%d7%aa-%d7%97%d7%96%d7%a7%d7%95%d7%aa-2-5-%d7%92%d7%a8%d7%9d-%d7%9c%d7%a0%d7%99%d7%a7%d7%95%d7%99-%d7%9e%d7%9b%d7%95%d7%a0%d7%aa-%d7%a7%d7%a4%d7%94-puly-cafe", "permalink": "https://www.minuto.co.il/product/60-%d7%98%d7%91%d7%9c%d7%99%d7%95%d7%aa-%d7%97%d7%96%d7%a7%d7%95%d7%aa-2-5-%d7%92%d7%a8%d7%9d-%d7%9c%d7%a0%d7%99%d7%a7%d7%95%d7%99-%d7%9e%d7%9b%d7%95%d7%a0%d7%aa-%d7%a7%d7%a4%d7%94-puly-cafe/", "date_created": "2025-03-25T10:22:46", "date_created_gmt": "2025-03-25T07:22:46", "date_modified": "2026-09-30T13:50:35", "date_modified_gmt": "2026-09-30T10:50:35", "type": "simple", "status": "publish", "featured": false, "catalog_visibility": "visible", "description": "<p><!-- wp:heading {\"level\":3} --></p>\n<h3 class=\"wp-block-heading\">60 טבליות חזקות 2.5 גרם לניקוי מכונת קפה - Puly Cafe</h3>\n<p><!-- /wp:heading --></p>\n<p><!-- wp:paragraph --></p>\n<p>טבליות אלו משמשות לניקוי השומנים המצטברים בתוך מכונות האספרסו האוטומטיות</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>מדובר בגלולות שנדחסו מחומר ניקוי (מסוג דדרגנט) לשימוש במכונות אספרסו אוטומטיות.</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>הטבליות העשויות מחומרים מתכלים, נבדקו ע\"י הרשות המוסמכת הבינלאומית&nbsp;<span dir=\"ltr\">NSF</span>&nbsp;ואושרו לשימוש מבחינה בריאותית והן מבחינת השפעתם המאכלת על החומרים מהם עשויים מכונות האספרסו.</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>הטבליות אלו עשויות בריכוז גבוה ביותר, נמסות לגמרי (100%), גם במים קרים. חומר הניקוי פעיל תוך 10 שניות מההמסה.</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>טבליות&nbsp;<span dir=\"ltr\">Puly</span>&nbsp;לניקוי מגיעות בשני גדלים 60 טבליות של 2.5 גרם או 100 טבליות של 1 גרם. הטבליות הגדולות של 2.5 גרם משמשות למכונות אספרסו אוטומטיות&nbsp;מקצועיות של יצרנים כגון:</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:html --></p>\n<div>&nbsp;<span dir=\"ltr\">Faema, La Cimbali, Jura, Brasilia, Cafe Swiss, Flavia, Etna, Santos, Gastro, WMF, Macco Mega, Franke Evolution and Bravilor.</span></div>\n<p><!-- /wp:html --></p>\n<p><!-- wp:html --></p>\n<div></div>\n<p><!-- /wp:html --></p>\n<p><!-- wp:html --></p>\n<div></div>\n<p><!-- /wp:html --></p>\n<p><!-- wp:html --></p>\n<div></div>\n<p><!-- /wp:html --></p>\n", "short_description": "", "sku": "8000733004704", "price": "80.0000", "regular_price": "80.0000", "sale_price": "", "date_on_sale_from": null, "date_on_sale_from_gmt": null, "date_on_sale_to": null, "date_on_sale_to_gmt": null, "on_sale": false, "purchasable": true, "total_sales": 6, "virtual": false, "downloadable": false, "downloads": [], "download_limit": -1, "download_expiry": -1, "external_url": "", "button_text": "", "tax_status": "taxable", "tax_class": "", "manage_stock": true, "stock_quantity": 1, "backorders": "no", "backorders_allowed": false, "backordered": false, "low_stock_amount": null, "sold_individually": false, "weight": "0", "dimensions": {"length": "", "width": "", "height": ""}, "shipping_required": true, "shipping_taxable": true, "shipping_class": "", "shipping_class_id": 0, "reviews_allowed": false, "average_rating": "0.00", "rating_count": 0, "upsell_ids": [], "cross_sell_ids": [], "parent_id": 0, "purchase_note": "", "categories": [{"id": 403, "name": "חומרי ניקוי", "slug": "%d7%97%d7%95%d7%9e%d7%a8%d7%99-%d7%a0%d7%99%d7%a7%d7%95%d7%99"}, {"id": 402, "name": "חומרי ניקוי ותחזוקה לקפה", "slug": "%d7%97%d7%95%d7%9e%d7%a8%d7%99-%d7%a0%d7%99%d7%a7%d7%95%d7%99-%d7%95%d7%aa%d7%97%d7%96%d7%95%d7%a7%d7%94-%d7%9c%d7%a7%d7%a4%d7%94"}, {"id": 374, "name": "מוצרים נלווים", "slug": "%d7%90%d7%91%d7%99%d7%96%d7%a8%d7%99-%d7%a7%d7%a4%d7%94"}], "brands": [], "tags": [], "images": [{"id": 68486, "date_created": "2025-03-25T10:23:45", "date_created_gmt": "2025-03-25T07:23:45", "date_modified": "2026-06-01T19:54:40", "date_modified_gmt": "2026-06-01T13:54:40", "src": "https://www.minut