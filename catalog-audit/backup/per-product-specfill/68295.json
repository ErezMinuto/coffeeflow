נה וקומפקטית,  יפה להפליא  &#8211; בעלת עיצוב אלגנטי וצבעוני</li>\n<li>מכינה אספרסו אמתי ואיכותי כמו ממכונת אספרסו רגילה</li>\n</ul>\n", "sku": "4897066230108", "price": "375.0000", "regular_price": "375.0000", "sale_price": "", "date_on_sale_from": null, "date_on_sale_from_gmt": null, "date_on_sale_to": null, "date_on_sale_to_gmt": null, "on_sale": false, "purchasable": true, "total_sales": 12, "virtual": false, "downloadable": false, "downloads": [], "download_limit": -1, "download_expiry": -1, "external_url": "", "button_text": "", "tax_status": "taxable", "tax_class": "", "manage_stock": true, "stock_quantity": 5, "backorders": "no", "backorders_allowed": false, "backordered": false, "low_stock_amount": null, "sold_individually": false, "weight": "", "dimensions": {"length": "", "width": "", "height": ""}, "shipping_required": true, "shipping_taxable": true, "shipping_class": "", "shipping_class_id": 0, "reviews_allowed": false, "average_rating": "0.00", "rating_count": 0, "upsell_ids": [], "cross_sell_ids": [], "parent_id": 0, "purchase_note": "", "categories": [{"id": 394, "name": "מכונות קפה", "slug": "%d7%9e%d7%9b%d7%95%d7%a0%d7%95%d7%aa-%d7%a7%d7%a4%d7%94"}, {"id": 428, "name": "מכונות קפה לקפסולות", "slug": "%d7%9e%d7%9b%d7%95%d7%a0%d7%95%d7%aa-%d7%a7%d7%a4%d7%94-%d7%9c%d7%a7%d7%a4%d7%a1%d7%95%d7%9c%d7%95%d7%aa"}, {"id": 485, "name": "מכונות קפה לשטח", "slug": "%d7%9e%d7%9b%d7%95%d7%a0%d7%95%d7%aa-%d7%a7%d7%a4%d7%94-%d7%9c%d7%a9%d7%98%d7%97"}, {"id": 478, "name": "מכונות קפה ניידות Wacaco", "slug": "%d7%9e%d7%9b%d7%95%d7%a0%d7%95%d7%aa-%d7%a7%d7%a4%d7%94-%d7%a0%d7%99%d7%99%d7%93%d7%95%d7%aa-wacaco"}, {"id": 484, "name": "מכונות קפה תואמות נספרסו", "slug": "%d7%9e%d7%9b%d7%95%d7%a0%d7%95%d7%aa-%d7%a7%d7%a4%d7%94-%d7%aa%d7%95%d7%90%d7%9e%d7%95%d7%aa-%d7%a0%d7%a1%d7%a4%d7%a8%d7%a1%d7%95"}, {"id": 548, "name": "מכשירי חליטה", "slug": "%d7%9e%d7%9b%d7%a9%d7%99%d7%a8%d7%99-%d7%97%d7%9c%d7%99%d7%98%d7%94"}], "brands": [], "tags": [], "images": [{"id": 68506, "dat