{"id": 64991, "name": "מקינטה ביאלטי בריקה 4 כוסות + קפה", "slug": "%d7%9e%d7%a7%d7%99%d7%a0%d7%98%d7%94-%d7%91%d7%99%d7%90%d7%9c%d7%98%d7%99-%d7%91%d7%a8%d7%99%d7%a7%d7%94-4-%d7%9b%d7%95%d7%a1%d7%95%d7%aa-%d7%a7%d7%a4%d7%94", "permalink": "https://www.minuto.co.il/product/%d7%9e%d7%a7%d7%99%d7%a0%d7%98%d7%94-%d7%91%d7%99%d7%90%d7%9c%d7%98%d7%99-%d7%91%d7%a8%d7%99%d7%a7%d7%94-4-%d7%9b%d7%95%d7%a1%d7%95%d7%aa-%d7%a7%d7%a4%d7%94/", "date_created": "2025-03-24T18:24:01", "date_created_gmt": "2025-03-24T15:24:01", "date_modified": "2026-09-17T21:19:54", "date_modified_gmt": "2026-09-17T18:19:54", "type": "woosb", "status": "publish", "featured": false, "catalog_visibility": "visible", "description": "<p><!-- wp:heading {\"level\":3} --></p>\n<h3 class=\"wp-block-heading\">מקינטה ביאלטי בריקה 4 כוסות + קפה</h3>\n<p><!-- /wp:heading --></p>\n<p><!-- wp:paragraph --></p>\n<p>במקינטה בריקה הדור החדש 2020  עם שסתום לחץ \"חכם\" המים עוברים דרך הקפה בלחץ אופטימלי לייצור קרמה עשירה.</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>יתרונות הבריקה הדור החדש:</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>כמות הקפה עלה מ-120 ל-140 מ\"ל.</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>הקרמה עלתה מ-30 ל-35 מ\"ל.</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>הטמפרטורה עולה מ-65 ל-70 מעלות צלסיוס.</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>הוידאו המצורף מדגים את תהליך יצירת הקרמה עם הבריקה הדור החדש.</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>להכנת 2-4 כוסות קפה</p>\n<p><!-- /wp:paragraph --></p>\n<p><!-- wp:paragraph --></p>\n<p>חברת ביאלטי הנה אחת החברות המובילות בתחום הקפה באיטליה. הקומה בשנת 1933</p>\n<p><!-- /wp:paragraph --></p>\n", "short_description": "<p>330 גר ספשלטי קפה מקינטה ביאלטי בריקה 4 כוסות מקינטה להכנת אספרסו של חברת ביאלטי מקינטה משמשת לבישול קפה אספרסו על הגז. <br />בתהליך פשוט של חימום המים והקפה מקבל קפה אספרסו איטלקי, עם ארומה וטעם שלא הולכים לאיבוד.  </p>\n", "sku": "21879", "price": "290.0000", "regular_price": "290.0000", "sale_price": "", "date_on_sale_from": null, "date_on_sale_from_gmt": null, "date_on_sale_to": null, "date_on_sale_to_gmt": null, "on_sale": false, "purchasable": true, "total_sales": 2, "virtual": false, "downloadable": false, "downloads": [], "download_limit": -1, "download_expiry": -1, "external_url": "", "button_text": "", "tax_status": "taxable", "tax_class": "", "manage_stock": true, "stock_quantity": 5, "backorders": "no", "backorders_allowed": false, "backordered": false, "low_stock_amount": null, "sold_individually": false, "weight": "", "dimensions": {"length": "", "width": "", "height": ""}, "shipping_required": true, "shipping_taxable": true, "shipping_class": "", "shipping_class_id": 0, "reviews_allowed": false, "average_rating": "0.00", "rating_count": 0, "upsell_ids": [], "cross_sell_ids": [], "parent_id": 0, "purchase_note": "", "categories": [{"id": 374, "name": "מוצרים נלווים", "slug": "%d7%90%d7%91%d7%99%d7%96%d7%a8%d7%99-%d7%a7%d7%a4%d7%94"}, {"id": 548, "name": "מכשירי חליטה", "slug": "%d7%9e%d7%9b%d7%a9%d7%99%d7%a8%d7%99-%d7%97%d7%9c%d7%99%d7%98%d7%94"}, {"id": 430, "name": "מקינטה", "slug": "%d7%90%d7%91%d7%99%d7%96%d7%a8%d7%99-%d7%a7%d7%a4%d7%94-%d7%9e%d7%a7%d7%99%d7%a0%d7%98%d7%95%d7%aa"}, {"id": 429, "name": "מקינטה ביאלטי - Bialetti", "slug": "%d7%91%d7%99%d7%90%d7%9c%d7%98%d7%99-bialetti"}], "brands": [], "tags": [], "images": [{"id": 66248, "date_created": "2025-03-24T18:32:14", "date_created_gmt": "2025-03-24T15:32:14", "date_modified": "2026-09-18T00:19:54", "date_modified_gmt": "2026-09-17T18:19:54", "src": "https://www.minuto.co.il/content/uploads/2025/03/1711549128_New_Bialetti_Brikka-4-1.png", "name": "1711549128_New_Bialetti_Brikka-4-1.png", "alt": "מקינטה ביאלטי בריקה 4 כוסות + קפה", "srcset": "https://www.minuto.co.il/content/uploads/2025/03/1711549128_New_Bialetti_Brikka-4-1.png 510w, https://www.minuto.co.il/content/uploads/20