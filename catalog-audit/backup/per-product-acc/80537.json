e=\"20\"><b data-index-in-node=\"0\" data-path-to-node=\"20\">הסט כולל:</b> ספל 210 מ\"ל ותחתית תואמת בגימור אפור מט.</p>\n", "short_description": "<p><b data-index-in-node=\"11\" data-path-to-node=\"14\">אלגנטיות שלווה מבית Club House.</b> ספל הקפוצ'ינו מדגם Tulipano של מותג הפורצלן האיטלקי Club House, בגימור אפור מט יוקרתי. שילוב בין עיצוב איטלקי על-זמני לבין איכות ייצור מקצועית. הגוון הניטרלי והחם הופך אותו לפריט עיצובי מושלם לכל מטבח המעריך קפה איכותי.</p>\n", "sku": "69723d32545a1", "price": "54.0000", "regular_price": "54.0000", "sale_price": "", "date_on_sale_from": null, "date_on_sale_from_gmt": null, "date_on_sale_to": null, "date_on_sale_to_gmt": null, "on_sale": false, "purchasable": true, "total_sales": 1, "virtual": false, "downloadable": false, "downloads": [], "download_limit": -1, "download_expiry": -1, "external_url": "", "button_text": "", "tax_status": "taxable", "tax_class": "", "manage_stock": true, "stock_quantity": 1, "backorders": "no", "backorders_allowed": false, "backordered": false, "low_stock_amount": null, "sold_individually": false, "weight": "0", "dimensions": {"length": "", "width": "", "height": ""}, "shipping_required": true, "shipping_taxable": true, "shipping_class": "", "shipping_class_id": 0, "reviews_allowed": false, "average_rating": "0.00", "rating_count": 0, "upsell_ids": [], "cross_sell_ids": [], "parent_id": 0, "purchase_note": "", "categories": [{"id": 438, "name": "ספלים וכוסות קפה", "slug": "%d7%a1%d7%a4%d7%9c%d7%99%d7%9d-%d7%95%d7%9b%d7%95%d7%a1%d7%95%d7%aa-%d7%a7%d7%a4%d7%94"}, {"id": 757, "name": "ספלי קפה Club House", "slug": "%d7%a1%d7%a4%d7%9c%d7%99%d7%9d-clubhouse"}], "brands": [], "tags": [], "images": [{"id": 80538, "date_created": "2026-05-11T16:24:05", "date_created_gmt": "2026-05-11T10:24:05", "date_modified": "2026-05-11T16:24:05", "date_modified_gmt": "2026-05-11T10:24:05", "src": "https://www.minuto.co.il/content/uploads/2026/05/1778494466_ספל20טולפינו20אפור.jpg", "name": "1778494466_ספל20טולפינו20אפור.j