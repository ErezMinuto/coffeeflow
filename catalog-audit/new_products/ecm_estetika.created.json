05dc \u05ea\u05d5\u05e6\u05d0\u05d4 \u05e2\u05e7\u05d1\u05d9\u05ea \u05d1\u05db\u05dc \u05e4\u05e2\u05dd.<\/p>\n<h3>\u05ea\u05db\u05d5\u05e0\u05d5\u05ea \u05e2\u05d9\u05e7\u05e8\u05d9\u05d5\u05ea<\/h3>\n<ul>\n<li>\u05de\u05e2\u05e8\u05db\u05ea \u05d3\u05d5\u05d3 \u05db\u05e4\u05d5\u05dc \u05e2\u05dd \u05d1\u05e7\u05e8\u05ea \u05d8\u05de\u05e4\u05e8\u05d8\u05d5\u05e8\u05d4 \u05de\u05e9\u05d5\u05dc\u05e9\u05ea (3C Temp)<\/li>\n<li>\u05e8\u05d0\u05e9 \u05d7\u05dc\u05d9\u05d8\u05d4 \u05de\u05d7\u05d5\u05de\u05dd \u05d1\u05e4\u05d9\u05ea\u05d5\u05d7 \u05d7\u05d3\u05e9<\/li>\n<li>\u05d7\u05d9\u05de\u05d5\u05dd \u05e1\u05d9\u05de\u05d5\u05dc\u05d8\u05e0\u05d9 \u05e9\u05dc \u05e9\u05e0\u05d9 \u05d4\u05d3\u05d5\u05d3\u05d9\u05dd \u05d5\u05de\u05e6\u05d1 \u05d7\u05d9\u05de\u05d5\u05dd \u05de\u05d4\u05d9\u05e8 (Fast Heat-Up)<\/li>\n<li>\u05e9\u05dc\u05d5\u05e9\u05d4 \u05db\u05e4\u05ea\u05d5\u05e8\u05d9\u05dd \u05d5\u05d5\u05dc\u05d5\u05de\u05d8\u05e8\u05d9\u05d9\u05dd \u05e0\u05d9\u05ea\u05e0\u05d9\u05dd \u05dc\u05ea\u05db\u05e0\u05d5\u05ea<\/li>\n<li>\u05d8\u05d9\u05d9\u05de\u05e8 \u05e9\u05d5\u05d8 \u05d5\u05ea\u05e6\u05d5\u05d2\u05ea Shot Observer<\/li>\n<li>\u05d6\u05de\u05e0\u05d9 \u05d4\u05e4\u05e2\u05dc\u05d4 \u05d5\u05db\u05d9\u05d1\u05d5\u05d9 \u05e0\u05d9\u05ea\u05e0\u05d9\u05dd \u05dc\u05ea\u05db\u05e0\u05d5\u05ea<\/li>\n<li>\u05de\u05e6\u05d1\u05d9 \u05e4\u05e8\u05d4\u05be\u05d0\u05d9\u05e0\u05e4\u05d9\u05d5\u05d6\u05df \u05d0\u05e7\u05d8\u05d9\u05d1\u05d9 \u05d5\u05e4\u05e1\u05d9\u05d1\u05d9<\/li>\n<li>\u05de\u05e9\u05d0\u05d1\u05d4 \u05e8\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea \u05e9\u05e7\u05d8\u05d4<\/li>\n<li>\u05ea\u05d0\u05d5\u05e8\u05ea Barista Lights<\/li>\n<li>\u05de\u05d3 \u05dc\u05d7\u05e5 \u05db\u05e4\u05d5\u05dc (\u05dc\u05d7\u05e5 \u05d3\u05d5\u05d3 \u05d5\u05dc\u05d7\u05e5 \u05d7\u05dc\u05d9\u05d8\u05d4)<\/li>\n<li>\u05e2\u05d9\u05e6\u05d5\u05d1 \u05d0\u05dc\u05d2\u05e0\u05d8\u05d9 \u05d1\u05d2\u05d9\u05de\u05d5\u05e8 \u05e9\u05d7\u05d5\u05e8 \u05de\u05d8<\/li>\n<\/ul>\n<h3>\u05de\u05e4\u05e8\u05d8 \u05d8\u05db\u05e0\u05d9<\/h3>\n<ul>\n<li><strong>\u05de\u05e2\u05e8\u05db\u05ea:<\/strong> \u05d3\u05d5\u05d3 \u05db\u05e4\u05d5\u05dc \u05e2\u05dd 3C Temp \u05d5\u05de\u05e9\u05d0\u05d1\u05d4 \u05e8\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea<\/li>\n<li><strong>\u05d3\u05d5\u05d3 \u05e7\u05e4\u05d4:<\/strong> \u05db\u05be0.5 \u05dc\u05d9\u05d8\u05e8, \u05e0\u05d9\u05e8\u05d5\u05e1\u05d8\u05d4<\/li>\n<li><strong>\u05d3\u05d5\u05d3 \u05e7\u05d9\u05d8\u05d5\u05e8\/\u05de\u05d9\u05dd \u05d7\u05de\u05d9\u05dd:<\/strong> \u05db\u05be2 \u05dc\u05d9\u05d8\u05e8, \u05e0\u05d9\u05e8\u05d5\u05e1\u05d8\u05d4<\/li>\n<li><strong>\u05de\u05d9\u05db\u05dc \u05de\u05d9\u05dd:<\/strong> \u05db\u05be2.8 \u05dc\u05d9\u05d8\u05e8, \u05e2\u05dd \u05d0\u05e4\u05e9\u05e8\u05d5\u05ea \u05dc\u05d7\u05d9\u05d1\u05d5\u05e8 \u05d9\u05e9\u05d9\u05e8 \u05dc\u05e8\u05e9\u05ea \u05d4\u05de\u05d9\u05dd (\u05e6\u05d9\u05e0\u05d5\u05e8 \u05de\u05ea\u05db\u05ea \u05db\u05dc\u05d5\u05dc)<\/li>\n<li><strong>\u05ea\u05e6\u05d5\u05d2\u05d4:<\/strong> 2 \u05ea\u05e6\u05d5\u05d2\u05d5\u05ea<\/li>\n<li><strong>\u05d1\u05e7\u05e8\u05d4:<\/strong> PID, \u05d6\u05de\u05df \u05e4\u05e8\u05d4\u05be\u05d0\u05d9\u05e0\u05e4\u05d9\u05d5\u05d6\u05df \u05de\u05ea\u05db\u05d5\u05d5\u05e0\u05df (\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9 \u05d5\u05e4\u05e1\u05d9\u05d1\u05d9), \u05de\u05e6\u05d1 ECO, \u05ea\u05d6\u05db\u05d5\u05e8\u05ea \u05e0\u05d9\u05e7\u05d5\u05d9 \u05e8\u05d0\u05e9 (CLn), \u05ea\u05d6\u05db\u05d5\u05e8\u05ea \u05d4\u05d7\u05dc\u05e4\u05ea \u05e4\u05d9\u05dc\u05d8\u05e8 (FL), \u05e9\u05e0\u05d9 \u05d6\u05de\u05e0\u05d9 \u05d4\u05e4\u05e2\u05dc\u05d4 \u05d5\u05db\u05d9\u05d1\u05d5\u05d9 \u05d1\u05d9\u05d5\u05dd, \u05ea\u05e6\u05d5\u05d2\u05ea \u05d8\u05de\u05e4\u05e8\u05d8\u05d5\u05e8\u05d4 \u05d1\u05be\u00b0C \u05d0\u05d5 \u00b0F<\/li>\n<li><strong>\u05e7\u05d9\u05d8\u05d5\u05e8:<\/strong> \u05e9\u05e8\u05d1\u05d9\u05d8 \u05e7\u05d9\u05d8\u05d5\u05e8 \u05d3\u05d5\u05be\u05d3\u05d5\u05e4\u05e0\u05d9 \u05e2\u05dd \u05d1\u05e8\u05d6 \u05de\u05e0\u05d5\u05e3<\/li>\n<li><strong>\u05de\u05ea\u05d7 \u05d5\u05d4\u05e1\u05e4\u05e7:<\/strong> 230 \u05d5\u05d5\u05dc\u05d8, 50\/60 \u05d4\u05e8\u05e5, 2800 \u05d5\u05d5\u05d0\u05d8<\/li>\n<li><strong>\u05de\u05d9\u05d3\u05d5\u05ea (\u05e8\u00d7\u05e2\u00d7\u05d2):<\/strong> 33.6\u00d748.7\u00d740.8 \u05e1\"\u05de (\u05dc\u05dc\u05d0 \u05d9\u05d3\u05d9\u05ea); \u05e2\u05d5\u05de\u05e7 \u05e2\u05dd \u05d9\u05d3\u05d9\u05ea 58.5 \u05e1\"\u05de<\/li>\n<li><strong>\u05de\u05e9\u05e7\u05dc:<\/strong> 29.4 \u05e7\"\u05d2<\/li>\n<li><strong>\u05de\u05e7\"\u05d8 \u05d9\u05e6\u05e8\u05df:<\/strong> CM100022-00<\/li>\n<\/ul>\n<h3>\u05de\u05d4 \u05d1\u05e7\u05d5\u05e4\u05e1\u05d4<\/h3>\n<ul>\n<li>\u05d9\u05d3\u05d9\u05ea \u05de\u05d5\u05d3\u05d5\u05dc\u05e8\u05d9\u05ea \u05e2\u05dd \u05ea\u05d5\u05e1\u05e4\u05d5\u05ea \u05e1\u05d9\u05dc\u05d9\u05e7\u05d5\u05df \u05dc\u05e9\u05d5\u05d8 \u05d9\u05d7\u05d9\u05d3 \u05d5\u05db\u05e4\u05d5\u05dc<\/li>\n<li>\u05d9\u05d3\u05d9\u05ea \u05e2\u05dd \u05e4\u05d9\u05d4 \u05db\u05e4\u05d5\u05dc\u05d4<\/li>\n<li>\u05e1\u05dc\u05e1\u05dc\u05d4 \u05dc\u05e9\u05d5\u05d8 \u05d9\u05d7\u05d9\u05d3 (7 \u05d2\u05e8\u05dd) \u05d5\u05e1\u05dc\u05e1\u05dc\u05d4 \u05dc\u05e9\u05d5\u05d8 \u05db\u05e4\u05d5\u05dc (14 \u05d2\u05e8\u05dd)<\/li>\n<li>\u05e1\u05dc\u05e1\u05dc\u05d4 \u05dc\u05dc\u05d0 \u05ea\u05d7\u05ea\u05d9\u05ea (Bottomless)<\/li>\n<li>\u05e1\u05dc\u05e1\u05dc\u05d4 \u05e2\u05d9\u05d5\u05d5\u05e8\u05ea \u05dc\u05e0\u05d9\u05e7\u05d5\u05d9<\/li>\n<li>\u05d3\u05d5\u05d7\u05e1\u05df \u05d5\u05de\u05d1\u05e8\u05e9\u05ea \u05e0\u05d9\u05e7\u05d5\u05d9<\/li>\n<li>\u05e6\u05d9\u05e0\u05d5\u05e8 \u05de\u05ea\u05db\u05ea \u05dc\u05d7\u05d9\u05d1\u05d5\u05e8 \u05dc\u05de\u05d9\u05dd, 1\/8\u2033 \u05dc\u05be3\/8\u2033 BSPP<\/li>\n<li>\u05d7\u05d5\u05d1\u05e8\u05ea \u05d4\u05d5\u05e8\u05d0\u05d5\u05ea \u05e9\u05d9\u05de\u05d5\u05e9<\/li>\n<\/ul>","short_description":"<p><strong>