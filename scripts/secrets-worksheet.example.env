# CoffeeFlow — credential worksheet
#
#   cp -n scripts/secrets-worksheet.example.env ~/coffeeflow-worksheet.env
#   # -n matters: without it, running this again silently overwrites a
#   # worksheet you have already filled in. That has happened.
#   # fill in the blanks, then:
#   ./scripts/load-worksheet.sh ~/coffeeflow-worksheet.env
#
# The loader pushes every non-empty line into Supabase Vault and then deletes this
# file. After that you never handle these values again — any session, on this Mac
# or started from your phone, fetches them automatically.
#
# ── WHERE TO GET THE BLANK ONES ──────────────────────────────────────────────
# NOT from Supabase. Edge function secrets are write-only: the dashboard cannot
# reveal them and the Management API returns sha256 hashes, not values. The 77
# already set in prod keep working, but they cannot be read back by anyone.
#
# So each blank has to come from the system that issued it. For most, minting a
# NEW credential is the fast path and is safe — it does not revoke the one the
# edge functions are using:
#
#   ANTHROPIC_API_KEY   console.anthropic.com -> API keys
#   GEMINI_API_KEY      Google AI Studio -> Get API key
#   WOO_KEY / SECRET    WooCommerce -> Settings -> Advanced -> REST API (Read)
#   SERPER_API_KEY      serper.dev dashboard (readable, no need to regenerate)
#
# Identifiers (ad account, page, pixel, customer id) are NOT secrets and are
# already reconstructable from the database, the live site or the Graph API —
# leave them blank, they are populated already.
#
# ── RULES ────────────────────────────────────────────────────────────────────
#   - leave a line blank to skip it; nothing blank is ever stored
#   - no quotes needed unless the value contains a space or a #
#   - do not add a trailing comment on a value line
#   - this file is temporary. The loader deletes it. Do not keep a copy.


# ═══════════════════════════════════════════════════════════════════════════
# ALREADY FILLED — read from the code, no action needed
# ═══════════════════════════════════════════════════════════════════════════
# These are configuration, not secrets. Each is the value the edge functions
# fall back to when the variable is unset, so it is what they actually use.

SUPABASE_URL=https://ytydgldyeygpzmlxvpvb.supabase.co
WOO_URL=https://www.minuto.co.il
MFLOW_BASE=https://my.mflow.co.il
DASHBOARD_URL=https://coffeeflow-neon.vercel.app
SENDER_EMAIL=info@minuto.co.il
ADMIN_ALERT_EMAIL=erez@minuto.co.il
VERTEX_LOCATION=us-central1

# The www matters: minuto.co.il 301-redirects to www, and a redirect turns a POST
# into a GET and drops the body. A bare-domain WOO_URL fails silently on writes.


# ═══════════════════════════════════════════════════════════════════════════
# WORTH FILLING FIRST — these unlock the most
# ═══════════════════════════════════════════════════════════════════════════

# Model calls from a shell: bake-offs, prompt testing, debugging agent output.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# WooCommerce REST. Lets me query the live catalogue and orders directly
# instead of going through an edge function every time.
WOO_KEY=
WOO_SECRET=

# Search/SERP data used by the SEO agents.
SERPER_API_KEY=


# ═══════════════════════════════════════════════════════════════════════════
# FILL WHEN YOU WANT ME DEBUGGING THAT INTEGRATION DIRECTLY
# ═══════════════════════════════════════════════════════════════════════════
# The edge functions already hold their own copies of all of these, so leaving
# them blank costs nothing today. Add one the next time something in that
# integration misbehaves and you want it inspected from a shell.

# Meta / Instagram
META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PIXEL_ID=

# Google Ads + Analytics
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_CUSTOMER_ID=
GOOGLE_LOGIN_CUSTOMER_ID=
GA4_PROPERTY_ID=
GCP_PROJECT_ID=

# MFlow — the single source of truth for revenue
MFLOW_PUBLIC_KEY=
MFLOW_SECRET_KEY=

# Email
RESEND_API_KEY=

# Telegram — the three bots
TELEGRAM_BOT_TOKEN=
COFFEE_BOT_TOKEN=
EMPLOYEE_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WordPress blog publishing
WP_BLOG_POST_USER_NAME=
WP_BLOG_POST_PASS=

# Misc
COFFEEFLOW_USER_ID=
