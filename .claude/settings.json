{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && git fetch origin 2>&1 || true",
            "statusMessage": "Syncing with team (git fetch)..."
          },
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && [ -x scripts/session-start.sh ] && ./scripts/session-start.sh 2>&1 || true",
            "statusMessage": "Loading credentials from Vault..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '[ -x \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secret-dumps.sh\" ] && exec \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secret-dumps.sh\" || exit 0'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./scripts/deploy-functions.sh:*)"
    ]
  }
}
