{
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "preview/**": true
    }
  },
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- . ':!dashboard' ':!supabase' ':!scripts' ':!docs' ':!wp-plugins' ':!cloudflare' ':!video' ':!.github' ':!.claude' ':(exclude,glob)*.md'"
}
